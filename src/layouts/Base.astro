---
import '../styles/global.css';
import Field from '../components/Field.astro';
const { title, description, current = '' } = Astro.props;
// single-page anchors; absolute so they work from the case-study pages too
const nav = [
  { href: '/#education',  label: 'Education',  id: 'education'  },
  { href: '/#experience', label: 'Experience', id: 'experience' },
  { href: '/#projects',   label: 'Projects',   id: 'projects'   },
  { href: '/#about',      label: 'About',      id: 'about'      },
  { href: '/#contact',    label: 'Contact',    id: 'contact'    },
  { href: '/Ahmed_Huzaifa_Malik_CV.pdf', label: 'CV' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<script is:inline>document.documentElement.classList.add('js')</script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<Field />

<header class="masthead">
  <div class="wrap masthead-in">
    <a class="brand" href="/">Ahmed Huzaifa Malik <em>Data Science</em></a>
    <nav class="nav">
      {nav.map(n => (
        <a href={n.href} data-spy={n.id} aria-current={current === n.label ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </div>
</header>

<main id="main"><slot /></main>

<footer>
  <div class="wrap foot-grid">
    <div>
      <p class="tick" style="margin-bottom:.6rem">Get in touch</p>
      <p style="margin:0;font-size:1.05rem">
        <a href="mailto:ahmedhuzaifamalik@gmail.com">ahmedhuzaifamalik@gmail.com</a>
      </p>
      <p style="margin:.35rem 0 0;font-size:1.05rem">
        <a href="tel:+923175569176">+92 317 5569176</a>
      </p>
    </div>
    <div>
      <p class="tick" style="margin-bottom:.6rem">Elsewhere</p>
      <p style="margin:0"><a href="https://github.com/real-huzaifa" target="_blank" rel="noopener">GitHub</a></p>
      <p style="margin:.35rem 0 0"><a href="https://www.linkedin.com/in/ahmed-huzaifa-malik/" target="_blank" rel="noopener">LinkedIn</a></p>
      <p style="margin:.35rem 0 0"><a href="/Ahmed_Huzaifa_Malik_CV.pdf">CV (PDF)</a></p>
    </div>
    <div>
      <p class="tick" style="margin-bottom:.6rem">Location</p>
      <p style="margin:0">Mansehra, Pakistan</p>
      <p class="tick" style="margin-top:1rem">Open to internships<br />and junior data roles</p>
    </div>
  </div>
</footer>

<script>
  const els = [...document.querySelectorAll('.reveal')];
  if (!('IntersectionObserver' in window)) {
    els.forEach(el => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver((es) => {
      es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
    els.forEach(el => io.observe(el));
    // safety net: nothing stays hidden for more than 3s
    setTimeout(() => els.forEach(el => el.classList.add('in')), 3000);
  }

  // count-up on tabular figures marked data-count
  const co = new IntersectionObserver((es) => {
    es.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target, to = parseFloat(el.dataset.count), dp = (el.dataset.dp|0);
      const suf = el.dataset.suffix || '';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { el.textContent = to.toFixed(dp)+suf; co.unobserve(el); return; }
      const t0 = performance.now(), dur = 900;
      const step = (t) => {
        const k = Math.min(1, (t - t0)/dur), e2 = 1 - Math.pow(1-k, 3);
        el.textContent = (to*e2).toFixed(dp)+suf;
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step); co.unobserve(el);
    });
  }, { threshold: 0.6 });
  document.querySelectorAll('[data-count]').forEach(el => co.observe(el));

  // scroll spy: mark the nav link for whichever section is in view
  const spyLinks = [...document.querySelectorAll('.nav a[data-spy]')];
  const spied = spyLinks.map(a => document.getElementById(a.dataset.spy)).filter(Boolean);
  if (spied.length) {
    const setActive = (id) => spyLinks.forEach(a =>
      a.dataset.spy === id ? a.setAttribute('aria-current','page') : a.removeAttribute('aria-current'));
    const so = new IntersectionObserver((es) => {
      const vis = es.filter(e => e.isIntersecting)
                    .sort((a,b) => b.intersectionRatio - a.intersectionRatio);
      if (vis.length) setActive(vis[0].target.id);
    }, { rootMargin: '-45% 0px -45% 0px', threshold: [0, .25, .5, 1] });
    spied.forEach(sec => so.observe(sec));
  }
</script>
</body>
</html>
