---
import Base from '../layouts/Base.astro';
const roles = [
  { org:'Teyzix Core', title:'Data Analytics Intern', place:'Lahore', when:'Jun – Jul 2026',
    lines:['Built a churn prediction model and shipped it as a Streamlit dashboard for live risk scoring.',
           'Ran an end-to-end analytics project: constructed the dataset, cleaned and transformed it, explored it, and presented findings in an interactive dashboard.',
           'Delivered retail sales and public transport analytics as Power BI dashboards with written reports for non-technical readers.'] },
  { org:'Qwetrum Technologies', title:'Data Analysis Intern', place:'Lahore', when:'Jun – Jul 2026',
    lines:['Worked through assigned technical projects in the remote cohort under mentorship.',
           'Applied cleaning, exploratory analysis and visualisation to real project datasets.',
           'Covered SQL querying, A/B testing, EDA and machine learning workflows.'] },
  { org:'Digital Empowerment Network', title:'Data Science Intern', place:'Islamabad', when:'Jul – Sep 2025',
    lines:['Ran collection, cleaning and preprocessing workflows to make datasets analysis-ready.',
           'Produced visualisations to surface trends in complex data.',
           'Trained and tuned models to improve performance.'] },
  { org:'DevelopersHub Corporation', title:'Data Science Intern', place:'Islamabad', when:'Apr – Jun 2025',
    lines:['Managed end-to-end data pipelines from collection through preprocessing.',
           'Built visualisations to communicate findings.',
           'Assisted with model training and tuning.'] },
];
---
<Base title="About — Ahmed Huzaifa Malik" description="Data science undergraduate at Pak-Austria Fachhochschule. Background, experience and how I approach data work." current="About">

<section>
  <div class="wrap">
    <p class="tick" style="margin:0 0 1.2rem">About</p>
    <h1 style="max-width:15ch">Data science, with the reasoning shown.</h1>
    <div class="intro">
      <p>
        I'm in my Data Science degree at Pak-Austria Fachhochschule Institute of Applied
        Sciences and Technology in Haripur, working mostly in Python, SQL and Power BI.
        Four internships so far, across churn modelling, retail and transport analytics,
        A/B testing and SQL reporting.
      </p>
      <p>
        The thread running through the work is a preference for finishing things. A model
        that scores well in a notebook has demonstrated very little; the same model behind
        an endpoint, returning consistent predictions on inputs it has never seen, has
        demonstrated something. That gap is where most of the difficulty lives, and it is
        the part I have spent the most time on.
      </p>
      <p>
        I also try to be careful about metrics. Accuracy on a 3.5% positive rate, precision
        when the expensive error is a false negative — the wrong measure will tell you a
        broken model is working, and it will do so convincingly. Picking the measure that
        matches the actual cost of being wrong is usually the highest-leverage decision in
        a project, and it happens before any modelling starts.
      </p>
    </div>
  </div>
</section>

<section>
  <div class="wrap rail">
    <div class="rail-mark"><span class="tick">Experience</span></div>
    <div>
      <ol class="roles">
        {roles.map(r => (
          <li class="reveal">
            <div class="r-head">
              <h2>{r.org}</h2>
              <span class="tick">{r.when}</span>
            </div>
            <p class="tick r-title">{r.title} · {r.place}</p>
            <ul>{r.lines.map(l => <li>{l}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section>
  <div class="wrap rail">
    <div class="rail-mark"><span class="tick">Education</span></div>
    <div class="two">
      <div>
        <h2 style="margin-bottom:.9rem">Degree</h2>
        <p style="margin:0"><b>BS Data Science</b></p>
        <p style="margin:.2rem 0 0">Pak-Austria Fachhochschule Institute of Applied Sciences and Technology, Haripur</p>
        <p class="tick" style="margin-top:.4rem">2023 – present</p>
      </div>
      <div>
        <h2 style="margin-bottom:.9rem">Certifications</h2>
        <ul class="certs">
          <li>Data Analyst in Python — DataCamp</li>
          <li>Data Visualization with Power BI and Tableau — DataCamp</li>
          <li>SQL Fundamentals — DataCamp</li>
          <li>Data Literacy — DataCamp</li>
          <li>Introduction to Data Analytics — Meta</li>
          <li>Python Data Analytics — Meta</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap rail">
    <div class="rail-mark"><span class="tick">Contact</span></div>
    <div>
      <h2 style="max-width:18ch;margin-bottom:1rem">Open to internships and junior data roles.</h2>
      <p style="margin-bottom:1.6rem">
        If you're hiring, the case studies are the fastest way to see how I think.
        Otherwise, email is the surest way to reach me.
      </p>
      <div class="cta">
        <a class="btn" href="mailto:ahmedhuzaifamalik@gmail.com">Email me</a>
        <a class="btn ghost" href="/Ahmed_Huzaifa_Malik_CV.pdf">Download CV</a>
      </div>
    </div>
  </div>
</section>

</Base>

<style>
  .intro{margin-top:1.6rem}
  .intro p{font-size:1.05rem;color:var(--muted)}
  .roles{list-style:none;margin:0;padding:0}
  .roles > li{border-top:1px solid var(--line);padding:1.5rem 0}
  .roles > li:first-child{border-top:0;padding-top:0}
  .r-head{display:flex;justify-content:space-between;gap:1.5rem;align-items:baseline;flex-wrap:wrap}
  .r-head h2{font-size:clamp(1.15rem,1.9vw,1.45rem)}
  .r-title{margin:.3rem 0 .9rem}
  .roles ul{margin:0;padding-left:1.1rem}
  .roles ul li{margin-bottom:.4rem;max-width:62ch}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1.5rem,4vw,3.5rem)}
  @media (max-width:760px){ .two{grid-template-columns:1fr} }
  .certs{margin:0;padding-left:1.1rem}
  .certs li{margin-bottom:.35rem}
  .cta{display:flex;gap:.7rem;flex-wrap:wrap}
</style>
