---
import Base from '../../layouts/Base.astro';
import PRCurve from '../../components/PRCurve.astro';
import Recall from '../../components/Recall.astro';
import Signif from '../../components/Signif.astro';
import LiveScore from '../../components/LiveScore.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(p => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const all = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
const i = all.findIndex(x => x.id === p.id);
const next = all[(i+1) % all.length];
---
<Base title={`${p.data.title} — Ahmed Huzaifa Malik`} description={p.data.outcome} current="Work">

<article>
  <section class="head">
    <div class="wrap">
      <p class="tick"><a href="/#projects" class="back">← All projects</a> / {p.data.period}</p>
      <h1>{p.data.title}</h1>
      <p class="outcome">{p.data.outcome}</p>
      <div class="metrics">
        {p.data.metrics.map(m => (
          <div class={`metric ${m.hl ? 'hl':''}`}><b>{m.value}</b><span class="tick">{m.label}</span></div>
        ))}
      </div>
      <dl class="meta">
        <div><dt class="tick">Role</dt><dd>{p.data.role}</dd></div>
        <div><dt class="tick">Stack</dt><dd>{p.data.stack.join(' · ')}</dd></div>
        <div><dt class="tick">Links</dt><dd>
          {p.data.repo && <a class="arrow-link" href={p.data.repo} target="_blank" rel="noopener">Repository ↗</a>}
          {p.data.demo && <> &nbsp; <a class="arrow-link" href={p.data.demo} target="_blank" rel="noopener">Live demo ↗</a></>}
          {p.data.docs && <> &nbsp; <a class="arrow-link" href={p.data.docs} target="_blank" rel="noopener">API docs ↗</a></>}
        </dd></div>
      </dl>
    </div>
  </section>

  <section class="body">
    <div class="wrap grid">
      <div class="prose"><Content /></div>
      <aside class="side">
        {p.data.figure === 'pr' && <PRCurve model={0.548} base={0.186} />}
        {p.data.figure === 'recall' && <Recall rate={0.78} of={10} />}
        {p.data.figure === 'signif' && <Signif />}
      </aside>
    </div>
  </section>

  {p.data.figure === 'pr' && (
    <section>
      <div class="wrap"><LiveScore /></div>
    </section>
  )}

  <section class="nextup">
    <div class="wrap">
      <p class="tick" style="margin:0 0 .7rem">Next case study</p>
      <a class="next" href={`/projects/${next.id}/`}>
        <h2>{next.data.title}</h2>
        <span class="go tick">Read →</span>
      </a>
    </div>
  </section>
</article>

</Base>

<style>
  .head{padding-bottom:clamp(2rem,4vw,3rem)}
  .head h1{max-width:19ch;margin:1rem 0 0}
  .outcome{font-size:clamp(1.05rem,1.6vw,1.25rem);margin:1.1rem 0 1.8rem;max-width:54ch;color:var(--muted)}
  .back{text-decoration:none;border-bottom:1px solid var(--rule)}
  .meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1.2rem;margin:1.8rem 0 0}
  .meta dt{margin-bottom:.3rem}
  .meta dd{margin:0;font-size:.95rem}

  .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,26rem);
    gap:clamp(1.5rem,4vw,3.5rem);align-items:start}
  @media (max-width:900px){ .grid{grid-template-columns:1fr} .side{order:-1} }
  .side{position:sticky;top:5.5rem}
  @media (max-width:900px){ .side{position:static} }

  .prose :global(h2){font-size:clamp(1.25rem,2.1vw,1.6rem);margin:2.4rem 0 .8rem;
    padding-top:1.4rem;border-top:1px solid var(--line)}
  .prose :global(h2:first-child){margin-top:0;padding-top:0;border-top:0}
  .prose :global(p){margin:0 0 1.05em}
  .prose :global(strong){font-weight:600}
  .prose :global(code){font-family:var(--f-mono);font-size:.85em;background:var(--bg-3);padding:.12em .35em}

  
  .nextup{border-top:1px solid var(--line-2)}
  .next{display:flex;justify-content:space-between;align-items:baseline;gap:1.5rem;
    text-decoration:none;flex-wrap:wrap}
  .next h2{font-size:clamp(1.3rem,2.4vw,2rem);max-width:26ch}
  .next:hover h2{color:var(--v5)}
  .go{color:var(--v5)}
</style>
