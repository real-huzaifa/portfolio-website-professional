---
import Base from '../layouts/Base.astro';
import PointField from '../components/PointField.astro';
import LiveScore from '../components/LiveScore.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<Base title="Ahmed Huzaifa Malik — Data Science" description="Data science undergraduate building deployed machine learning systems. Fraud detection, churn prediction and analytics work, with the reasoning written out.">

<section class="hero">
  <div class="wrap">
    <p class="tick eyebrow">Data science undergraduate · Pak-Austria Fachhochschule</p>
    <h1>I build models that<br />leave the notebook.</h1>
    <p class="lede">
      Most of what makes a model useful happens after it trains: choosing a metric that
      reflects the actual cost of being wrong, splitting data the way production will see
      it, and getting the thing behind an endpoint that answers. That is the work I care
      about, and it is what these three projects document.
    </p>
    <div class="cta">
      <a class="btn" href="/projects/">Read the case studies</a>
      <a class="btn ghost" href="/Ahmed_Huzaifa_Malik_CV.pdf">Download CV</a>
    </div>
  </div>
  <div class="wrap pf-wrap"><PointField /></div>
</section>

<section>
  <div class="wrap rail">
    <div class="rail-mark"><span class="tick">Selected work</span></div>
    <div>
      <ol class="work">
        {projects.map((p) => (
          <li class="reveal">
            <a href={`/projects/${p.id}/`}>
              <div class="w-head">
                <h2>{p.data.title}</h2>
                <span class="tick w-year">{p.data.period}</span>
              </div>
              <p class="w-out">{p.data.outcome}</p>
              <div class="metrics w-metrics">
                {p.data.metrics.slice(0,4).map(m => (
                  <div class={`metric ${m.hl ? 'hl' : ''}`}>
                    <b>{m.value}</b><span class="tick">{m.label}</span>
                  </div>
                ))}
              </div>
              <p class="tick w-stack">{p.data.stack.join(' · ')}<span class="go">Read case study →</span></p>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section>
  <div class="wrap rail">
    <div class="rail-mark"><span class="tick">Live</span></div>
    <div>
      <h2 style="margin-bottom:.8rem">The fraud model, running</h2>
      <p style="margin-bottom:1.6rem">
        A repository link asks you to take my word for it. This calls the deployed
        service directly from your browser.
      </p>
      <LiveScore />
    </div>
  </div>
</section>

<section>
  <div class="wrap rail">
    <div class="rail-mark"><span class="tick">Background</span></div>
    <div class="two">
      <div>
        <h2 style="margin-bottom:1rem">Where I've worked</h2>
        <ul class="roles">
          <li><b>Teyzix Core</b><span class="tick">Data Analytics Intern · 2026</span></li>
          <li><b>Qwetrum Technologies</b><span class="tick">Data Analysis Intern · 2026</span></li>
          <li><b>Digital Empowerment Network</b><span class="tick">Data Science Intern · 2025</span></li>
          <li><b>DevelopersHub Corporation</b><span class="tick">Data Science Intern · 2025</span></li>
        </ul>
        <p style="margin-top:1.2rem"><a class="arrow-link" href="/about/">More about how I work →</a></p>
      </div>
      <div>
        <h2 style="margin-bottom:1rem">Tools I reach for</h2>
        <dl class="tools">
          <dt class="tick">Analysis</dt><dd>Python · SQL · pandas · NumPy</dd>
          <dt class="tick">Modelling</dt><dd>scikit-learn · LightGBM · XGBoost</dd>
          <dt class="tick">Shipping</dt><dd>FastAPI · Docker · Streamlit · Git</dd>
          <dt class="tick">Reporting</dt><dd>Power BI · Matplotlib · Excel</dd>
        </dl>
      </div>
    </div>
  </div>
</section>

</Base>

<style>
  .hero{padding-top:clamp(3rem,7vw,5.5rem);padding-bottom:clamp(2rem,4vw,3rem)}
  .eyebrow{margin:0 0 1.4rem}
  .lede{font-size:clamp(1.05rem,1.5vw,1.22rem);max-width:60ch;margin-top:1.5rem;color:var(--muted)}
  .cta{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:2rem}
  .pf-wrap{margin-top:clamp(2rem,5vw,3.5rem)}

  .work{list-style:none;margin:0;padding:0;display:grid;gap:0}
  .work li{border-top:1px solid var(--line)}
  .work li:first-child{border-top:0}
  .work a{display:block;text-decoration:none;padding:clamp(1.6rem,3vw,2.4rem) 0;
    transition:background .2s}
  .work a:hover{background:var(--bg-2)}
  .w-head{display:flex;justify-content:space-between;gap:1.5rem;align-items:baseline}
  .w-head h2{font-size:clamp(1.35rem,2.4vw,1.95rem);max-width:22ch}
  .w-year{white-space:nowrap}
  .w-out{margin:.7rem 0 1.3rem;color:var(--muted);max-width:56ch}
  .w-metrics{margin-bottom:1.1rem}
  .w-stack{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin:0}
  .go{color:var(--v5)}

  .two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1.5rem,4vw,3.5rem)}
  @media (max-width:760px){ .two{grid-template-columns:1fr} }
  .roles{list-style:none;margin:0;padding:0}
  .roles li{padding:.75rem 0;border-bottom:1px solid var(--line)}
  .roles b{display:block;font-weight:600}
  .roles span{display:block;margin-top:.15rem}
  .tools{margin:0}
  .tools dt{margin-top:.9rem}
  .tools dd{margin:.2rem 0 0}
</style>
