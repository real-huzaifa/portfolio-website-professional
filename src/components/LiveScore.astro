---
/* Calls the deployed fraud API from the browser.
   The free tier sleeps after 15 minutes, so a cold start is the normal
   first experience — the component says so rather than looking broken. */
import { FRAUD_API, FRAUD_DEMO } from '../config';
---
<div class="live panel reveal" data-api={FRAUD_API}>
  <div class="live-head">
    <p class="tick" style="margin:0">Score a transaction against the live model</p>
    <span class="status tick" data-status><i class="dot"></i>checking</span>
  </div>

  <p class="lead">
    This calls the deployed FastAPI service directly. The container sleeps after
    15 minutes idle, so the first request may take 10&ndash;30 seconds to wake it.
  </p>

  <div class="controls">
    <label>Transaction amount (USD)
      <input type="range" name="amt" min="5" max="2000" value="420" step="5" />
      <output class="num" data-out="amt">420</output>
    </label>
    <label>Product category
      <select name="prod">
        <option value="W">W — most common</option>
        <option value="C">C</option>
        <option value="R">R</option>
        <option value="H">H</option>
        <option value="S">S</option>
      </select>
      <span></span>
    </label>
    <label>Card type
      <select name="card">
        <option value="visa">Visa</option>
        <option value="mastercard">Mastercard</option>
        <option value="discover">Discover</option>
      </select>
      <span></span>
    </label>
  </div>

  <div class="acts">
    <button class="btn" data-run>Send to API</button>
    <a class="arrow-link" href={FRAUD_DEMO} target="_blank" rel="noopener">Full demo, with real records ↗</a>
  </div>

  <div class="result" data-result hidden>
    <div class="meter"><i data-bar></i></div>
    <div class="rrow">
      <p class="num big" data-prob>—</p>
      <p class="tick" data-verdict></p>
    </div>
  </div>
  <p class="figcap" data-note></p>
</div>

<style>
  .live-head{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
  .status{display:inline-flex;align-items:center;gap:.45rem}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--muted);display:block}
  .status[data-state="live"] .dot{background:var(--v3);box-shadow:0 0 0 3px rgba(34,168,132,.18)}
  .status[data-state="wake"] .dot{background:var(--v5);animation:pulse 1.1s ease-in-out infinite}
  .status[data-state="down"] .dot{background:#8A4B4B}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.25}}
  .lead{font-size:.95rem;color:var(--muted);margin:.8rem 0 1.3rem;max-width:56ch}
  .controls{display:grid;gap:.9rem;margin-bottom:1.3rem}
  label{display:grid;grid-template-columns:1fr auto;gap:.4rem .8rem;align-items:center;
    font-family:var(--f-mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  input[type=range]{grid-column:1/-1;width:100%;accent-color:var(--v5)}
  select{grid-column:1/-1;background:var(--bg-3);color:var(--fg);border:1px solid var(--line);
    padding:.5rem .6rem;font-family:var(--f-mono);font-size:.8rem}
  output{font-size:.95rem;color:var(--fg)}
  .acts{display:flex;gap:1.2rem;align-items:center;flex-wrap:wrap}
  .result{margin-top:1.5rem;border-top:1px solid var(--line);padding-top:1.2rem}
  .meter{height:10px;background:var(--bg-3);border:1px solid var(--line);overflow:hidden}
  .meter i{display:block;height:100%;width:0;transition:width .8s cubic-bezier(.3,0,.2,1);
    background:linear-gradient(90deg,var(--v1),var(--v2),var(--v3),var(--v4),var(--v5))}
  .rrow{display:flex;align-items:baseline;gap:1rem;flex-wrap:wrap;margin-top:.8rem}
  .big{font-size:2.2rem;margin:0;line-height:1}
</style>

<script>
  const root = document.querySelector('.live');
  if (root) {
    const API = root.dataset.api;
    const $ = (s) => root.querySelector(s);
    const statusEl = $('[data-status]'), note = $('[data-note]'), res = $('[data-result]');
    const bar = $('[data-bar]'), prob = $('[data-prob]'), verdict = $('[data-verdict]');
    const setStatus = (state, text) => { statusEl.dataset.state = state;
      statusEl.innerHTML = '<i class="dot"></i>' + text; };

    root.querySelectorAll('input[type=range]').forEach(r => {
      const out = root.querySelector(`[data-out="${r.name}"]`);
      const sync = () => out.textContent = r.value;
      r.addEventListener('input', sync); sync();
    });

    let live = false;
    fetch(API + '/health')
      .then(r => r.ok ? r.json() : Promise.reject())
      .then(() => { live = true; setStatus('live', 'model loaded'); })
      .catch(() => setStatus('down', 'asleep — will wake on first call'));

    $('[data-run]').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      btn.disabled = true; btn.textContent = 'Scoring…';
      setStatus('wake', live ? 'scoring' : 'waking container');
      note.textContent = '';

      const payload = {
        TransactionAmt: +root.querySelector('[name=amt]').value,
        ProductCD: root.querySelector('[name=prod]').value,
        card4: root.querySelector('[name=card]').value
      };

      try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 45000);
        const r = await fetch(API + '/predict', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload), signal: ctrl.signal
        });
        clearTimeout(timer);
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const j = await r.json();
        const p = j.fraud_probability ?? j.probability ?? j.score;
        if (typeof p !== 'number') throw new Error('unexpected response shape');

        live = true; setStatus('live', 'model loaded');
        res.hidden = false;
        bar.style.width = Math.min(100, p * 100).toFixed(1) + '%';
        prob.textContent = (p * 100).toFixed(1) + '%';
        verdict.textContent = p >= 0.5 ? 'flagged for review' : 'cleared';
        note.textContent = 'Returned by the live API. This form sends only three of the '
          + "model's 431 features, so scores sit near the uncertain middle — the full demo "
          + 'sends complete records, which is where the model gives confident verdicts.';
      } catch (err) {
        setStatus('down', 'no response');
        res.hidden = true;
        note.textContent = 'The API did not respond. It sleeps after 15 minutes idle and '
          + 'can take up to 30 seconds to wake — try once more, or open the full demo.';
      } finally {
        btn.disabled = false; btn.textContent = 'Send to API';
      }
    });
  }
</script>
