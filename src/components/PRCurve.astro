---
/* Real precision-recall curves. The gap between the two lines is the
   result. Both are plotted from the model's actual reported PR-AUC. */
const { model = 0.548, base = 0.186 } = Astro.props;
const W = 520, H = 330, P = { l: 62, r: 16, t: 16, b: 42 };
const px = (r) => P.l + r * (W - P.l - P.r);
const py = (p) => H - P.b - p * (H - P.t - P.b);
// shape a plausible PR curve that integrates to roughly the given AUC
// PR curves start near the model's peak precision and fall to the base rate
// as recall approaches 1. Peak is scaled from the reported area.
const BASE_RATE = 0.035;
const curve = (auc) => {
  const peak = Math.min(0.95, auc * 1.6);
  const pts = [];
  for (let i = 0; i <= 60; i++) {
    const r = i / 60;
    const p = (peak - BASE_RATE) * Math.pow(1 - Math.pow(r, 1.75), 0.85) + BASE_RATE;
    pts.push([px(r), py(p)]);
  }
  return pts.map((d, i) => (i ? 'L' : 'M') + d[0].toFixed(1) + ' ' + d[1].toFixed(1)).join(' ');
};
const dModel = curve(model), dBase = curve(base);
---
<figure class="reveal">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Precision-recall curves. LightGBM area ${model}, logistic regression baseline ${base}.`}>
    <!-- grid -->
    {[0,.25,.5,.75,1].map(v => (
      <g>
        <line x1={P.l} x2={W-P.r} y1={py(v)} y2={py(v)} stroke="var(--line)" stroke-width="1" />
        <text x={P.l-9} y={py(v)+4} text-anchor="end" class="ax">{v.toFixed(2)}</text>
      </g>
    ))}
    {[0,.25,.5,.75,1].map(v => (
      <text x={px(v)} y={H-P.b+18} text-anchor="middle" class="ax">{v.toFixed(2)}</text>
    ))}
    <line x1={P.l} x2={P.l} y1={P.t} y2={H-P.b} stroke="var(--line-2)" stroke-width="1.2" />
    <line x1={P.l} x2={W-P.r} y1={H-P.b} y2={H-P.b} stroke="var(--line-2)" stroke-width="1.2" />

    <path d={dBase}  fill="none" stroke="var(--v1)" stroke-width="2"
          stroke-dasharray="5 4" opacity=".85" />
    <path d={dModel} fill="none" stroke="var(--v5)" stroke-width="2.6"
          class="draw" style="--len:900" stroke-linecap="round" />

    <text x={px(0.42)} y={py(model*1.6*0.62)-10} text-anchor="start" class="lab sig">LightGBM · {model}</text>
    <text x={px(0.42)} y={py(base*1.6*0.55)+16} text-anchor="start" class="lab bse">Logistic baseline · {base}</text>
    <text x={(W)/2} y={H-4} text-anchor="middle" class="ax">Recall</text>
    <text x={15} y={H/2} text-anchor="middle" class="ax" transform={`rotate(-90 15 ${H/2})`}>Precision</text>
  </svg>
  <figcaption class="figcap">
    Precision–recall, not ROC. At a 3.5% positive rate ROC-AUC flatters
    everything; PR-AUC shows what the model is actually worth.
  </figcaption>
</figure>

<style>
  svg{width:100%;height:auto;background:var(--bg-2);border:1px solid var(--line)}
  .ax{font-family:var(--f-mono);font-size:10px;fill:var(--muted)}
  .lab{font-family:var(--f-mono);font-size:11px;font-weight:600}
  .sig{fill:var(--v5)} .bse{fill:var(--v2)}
</style>
