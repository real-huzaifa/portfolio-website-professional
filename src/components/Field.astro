---
/* Live background.
   A cloud of points initialised at random and pulled toward learned
   centroids — what a t-SNE or UMAP embedding looks like while it settles.
   Points are coloured along the viridis ramp by cluster, and short edges
   are drawn between near neighbours, so the structure emerges rather than
   being declared. It never fully stops: the field keeps breathing. */
---
<canvas id="field" aria-hidden="true"></canvas>

<script>
  const cv = document.getElementById('field');
  if (cv) {
    const ctx = cv.getContext('2d', { alpha: true });
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const RAMP = ['#440154','#414487','#2A788E','#22A884','#7AD151','#FDE725'];

    let W = 0, H = 0, pts = [], cents = [], raf = 0, t = 0, running = true;

    const rand = (a, b) => a + Math.random() * (b - a);

    const build = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = innerWidth; H = innerHeight;
      cv.width = W * dpr; cv.height = H * dpr;
      cv.style.width = W + 'px'; cv.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const k = W < 700 ? 4 : 6;                       // clusters
      const n = W < 700 ? 130 : W < 1200 ? 240 : 340;  // points

      cents = Array.from({ length: k }, (_, i) => ({
        x: rand(W * .12, W * .88), y: rand(H * .14, H * .86),
        vx: rand(-.05, .05), vy: rand(-.05, .05),
        c: RAMP[i % RAMP.length]
      }));

      pts = Array.from({ length: n }, () => {
        const g = (Math.random() * cents.length) | 0;
        return {
          x: rand(0, W), y: rand(0, H),
          g, r: rand(.9, 2.1),
          sp: rand(.006, 0.02),                        // convergence rate
          ox: rand(-70, 70), oy: rand(-70, 70),        // offset within cluster
          ph: rand(0, 6.283)
        };
      });
    };

    const draw = () => {
      t += 0.006;
      ctx.clearRect(0, 0, W, H);

      // centroids drift slowly so the embedding never freezes
      for (const c of cents) {
        c.x += c.vx; c.y += c.vy;
        if (c.x < W * .1 || c.x > W * .9) c.vx *= -1;
        if (c.y < H * .12 || c.y > H * .88) c.vy *= -1;
      }

      // pull each point toward its centroid
      for (const p of pts) {
        const c = cents[p.g];
        const tx = c.x + p.ox + Math.sin(t + p.ph) * 16;
        const ty = c.y + p.oy + Math.cos(t * .8 + p.ph) * 16;
        p.x += (tx - p.x) * p.sp;
        p.y += (ty - p.y) * p.sp;
      }

      // near-neighbour edges, drawn only within a cluster
      ctx.lineWidth = 1;
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i];
        for (let j = i + 1; j < pts.length; j++) {
          const b = pts[j];
          if (a.g !== b.g) continue;
          const dx = a.x - b.x, dy = a.y - b.y, d2 = dx * dx + dy * dy;
          if (d2 < 5200) {
            ctx.strokeStyle = cents[a.g].c;
            ctx.globalAlpha = (1 - d2 / 5200) * .16;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
      }

      ctx.globalAlpha = 1;
      for (const p of pts) {
        ctx.fillStyle = cents[p.g].c;
        ctx.globalAlpha = .62;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.283); ctx.fill();
      }
      ctx.globalAlpha = 1;

      if (running) raf = requestAnimationFrame(draw);
    };

    build();
    if (reduce) { draw(); running = false; cancelAnimationFrame(raf); }
    else raf = requestAnimationFrame(draw);

    // stop work when the tab is hidden
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { running = false; cancelAnimationFrame(raf); }
      else if (!reduce) { running = true; raf = requestAnimationFrame(draw); }
    });

    let rt; addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(build, 200); });
  }
</script>
